{
  "name": "dsh-plugin-local-infer",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "DeepSeek Harness plugin that manages local inference engines (llama.cpp, NInfer, Hyper-Qwen, Strata): configure, size, launch, and publish a local engine as a DSH model. Installable bundle that mounts the localInfer service, engine providers, model-facing tools, and the Web UI as one profile layer.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "cordis-plugin",
    "local-inference",
    "llama.cpp",
    "ninfer",
    "vllm",
    "llm",
    "vram",
    "ai-agent"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "exports": {
    ".": "./dsh/host.js",
    "./client": "./dsh/client.js",
    "./core": {
      "types": "./packages/core/lib/index.d.ts",
      "default": "./packages/core/lib/index.js"
    },
    "./service": {
      "types": "./packages/service/lib/index.d.ts",
      "default": "./packages/service/lib/index.js"
    },
    "./providers": {
      "types": "./packages/providers/lib/index.d.ts",
      "default": "./packages/providers/lib/index.js"
    },
    "./tool": {
      "types": "./packages/tool/lib/index.d.ts",
      "default": "./packages/tool/lib/index.js"
    },
    "./ui": {
      "types": "./packages/ui/lib/index.d.ts",
      "default": "./packages/ui/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "dsh/client.js",
    "dsh/host.js",
    "packages/core/package.json",
    "packages/core/lib/**/*.js",
    "packages/core/lib/**/*.d.ts",
    "packages/service/package.json",
    "packages/service/lib/**/*.js",
    "packages/service/lib/**/*.d.ts",
    "packages/providers/package.json",
    "packages/providers/lib/**/*.js",
    "packages/providers/lib/**/*.d.ts",
    "packages/tool/package.json",
    "packages/tool/lib/**/*.js",
    "packages/tool/lib/**/*.d.ts",
    "packages/ui/package.json",
    "packages/ui/lib/**/*.js",
    "packages/ui/lib/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.4"
  }
}
