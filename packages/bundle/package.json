{
  "name": "dsh-plugin-local-infer-bundle",
  "version": "0.1.1",
  "description": "Installable meta-package for the dsh local-inference plugin: no source, just the cordis.patch.yml that wires the service, providers, tool, and ui into one profile layer",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "local-inference",
    "bundle"
  ],
  "license": "MIT",
  "type": "module",
  "private": true,
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "cordis.patch.yml"
  ],
  "dependencies": {
    "dsh-plugin-local-infer-service": "workspace:^",
    "dsh-plugin-local-infer-providers": "workspace:^",
    "dsh-plugin-local-infer-tool": "workspace:^",
    "dsh-plugin-local-infer-ui": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.2"
  }
}
